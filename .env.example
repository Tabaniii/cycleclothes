# Salin file ini ke .env.local, lalu isi nilai asli dari dashboard.
# Jangan pernah commit kunci asli.

# Supabase — Dashboard → Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Stripe sandbox — Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Cron (Vercel Cron Authorization: Bearer CRON_SECRET)
CRON_SECRET=replace_with_random_cron_secret

# Seed script
SEED_PASSWORD=replace_with_seed_password
